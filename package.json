{
  "name": "miniagent",
  "version": "0.1.0",
  "description": "MiniAgent - minimal Node.js + TypeScript project",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build-info": "node scripts/build-info.mjs",
    "postinstall": "node scripts/build-info.mjs",
    "build": "pnpm build-info && tsc -p tsconfig.build.json",
    "dev": "pnpm build-info && tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "pnpm build-info && vitest run",
    "test:watch": "pnpm build-info && vitest",
    "typecheck": "pnpm build-info && tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.78",
    "ai": "^7.0.116",
    "zod": "^4.6.5"
  }
}
